PORT=8080
SUPABASE_URL=                   # required — server refuses to start without it
SUPABASE_SERVICE_ROLE_KEY=      # required — server-only
SUPABASE_JWT_SECRET=            # verify user JWTs
ELEVENLABS_API_KEY=             # required
OPENROUTER_API_KEY=             # required when EVAL_PROVIDER=openrouter
EVAL_PROVIDER=openrouter        # openrouter | gemini
GEMINI_API_KEY=                 # only used when EVAL_PROVIDER=gemini
EVAL_MODEL=google/gemini-3.1-flash-lite
ADMIN_PASSWORD=                 # required — the server refuses to start without it
ADMIN_COOKIE_SECRET=            # required — signs the admin session cookie (no default)
DAILY_EVAL_LIMIT=25
RATE_LIMIT_TRANSCRIBE_PER_HOUR=30   # per-IP ceilings on the billable routes
RATE_LIMIT_EVAL_PER_HOUR=30
RATE_LIMIT_SAVE_PER_HOUR=20
MEDIA_CONCURRENCY=2             # simultaneous ffmpeg jobs; beyond this requests queue
MEDIA_QUEUE_MAX=8               # …and past this they get 503 busy
FFMPEG_TIMEOUT_MS=60000         # hard kill for a wedged ffmpeg child
SURGE_MAX_CALLS=300             # total API calls…
SURGE_WINDOW_MIN=5              # …per this many minutes → kill switch
MAX_UPLOAD_MB=60
MAX_TAKE_S=30                   # hard take ceiling (byte guard above is orthogonal)
TAKE_TOLERANCE_S=3              # …reject only past MAX_TAKE_S + this (container slop)
SCRIBE_USD_PER_MIN=0.004        # ElevenLabs Scribe list ~$0.24/hr as of 2026-08
# Required CORS + admin-CSRF allowlist; comma-separated browser client origins
CLIENT_ORIGIN=http://localhost:3000
