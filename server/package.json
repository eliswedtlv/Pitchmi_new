{
  "name": "pitchmi-server",
  "version": "1.0.0",
  "description": "PitchMi v1 API — Express backend",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "make-sample": "node scripts/make-sample.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "standard": "^17.1.0",
    "supertest": "^7.0.0"
  },
  "standard": {
    "env": [
      "jest",
      "node"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
